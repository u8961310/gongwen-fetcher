{
  "name": "gongwen-fetcher",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/index.js",
    "dry-run": "node src/index.js --dry-run",
    "test": "node --test",
    "app": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tw.gongwen.fetcher",
    "productName": "公文附件下載器",
    "directories": { "output": "dist" },
    "files": ["electron/**/*", "src/**/*", "package.json"],
    "asarUnpack": ["**/node_modules/playwright/**", "**/node_modules/playwright-core/**"],
    "extraResources": [{ "from": "ms-playwright", "to": "ms-playwright" }],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "授權說明.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "公文附件下載器"
    }
  }
}
